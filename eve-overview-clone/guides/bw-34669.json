orpus B-Type Heavy Energy Nosferatu","10 sec","28 km","14 km","120 GJ","12 GJ/s","2400 MW","50 tf"],["Deadspace","14","Corpus A-Type Heavy Energy Nosferatu","10 sec","30 km&gt;","15 km","120 GJ","12 GJ/s","2600 MW","50 tf"],["Deadspace","16","Corpus X-Type Heavy Energy Nosferatu","10 sec","32 km","16 km","120 GJ","12 GJ/s","2800 MW","50 tf"]]},{"t":"h2","zh":"Implants"},{"t":"table","hr":[true,false,false,false,false,false,false],"zh":[["Name","Effect","Set Effect","Attribute"],["Alpha","1% reduction of duration","10% 加成 of the set","+2 Perception"],["Bravo","2% reduction of duration","10% 加成 of the set","+2 Memory"],["Gamma","3% reduction of duration","10% 加成 of the set","2 毅力"],["Delta","4% reduction of duration","10% 加成 of the set","2 智力"],["Epsilon","5% reduction of duration","10% 加成 of the set","2 魅力"],["Omega","","25% 加成 of the set"]]},{"t":"table","hr":[true,false,false,false,false,false,false],"zh":[["Name","Effect","Set Effect","Attribute"],["Alpha","1% reduction of duration","15% 加成 of the set","+3 Perception"],["Bravo","2% reduction of duration","15% 加成 of the set","+3 Memory"],["Gamma","3% reduction of duration","15% 加成 of the set","3 毅力"],["Delta","4% reduction of duration","15% 加成 of the set","3 智力"],["Epsilon","5% reduction of duration","15% 加成 of the set","3 魅力"],["Omega","","50% 加成 of the set"]]},{"t":"h2","zh":"Boosters"},{"t":"table","hr":[true,false,false,false,false],"zh":[["Type","Increases Cap by","Side Effect Chance","Side Effect Strength"],["Synth","6%","0%","0%"],["Standard","10%","20%","20%"],["Improved","15%","30%","25%"],["Strong","20%","40%","30%"]]},{"t":"ul","d":[0,0],"zh":["数量","装甲维修量"]},{"t":"h2","zh":"Capacitor Warfare and PvP Ships"},{"t":"h2","zh":"Unbonused ships"}]}