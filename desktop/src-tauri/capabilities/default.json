{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "线上网站只允许：用系统浏览器打开链接、发系统通知、开关悬浮窗与详情窗口、截 EVE 窗口（本地红名）、读 EVE 日志文件夹（日志预警，只读）、手动检查更新",
  "windows": ["main", "float", "float-*"],
  "remote": {
    "urls": [
      "https://eve.navexor.top/*"
    ]
  },
  "permissions": [
    "opener:default",
    "notification:default",
    "allow-float-open",
    "allow-float-pass",
    "allow-float-drag",
    "allow-float-close",
    "allow-float-focus-main",
    "allow-float-detail",
    "allow-local-grab",
    "allow-local-windows",
    "allow-update-check",
    "allow-logs-dir",
    "allow-logs-list",
    "allow-logs-stat",
    "allow-logs-read"
  ]
}
